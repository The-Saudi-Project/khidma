# Frontend environment variables
# These are used at BUILD TIME by Vite (must start with VITE_)
# For Vercel: set these in Project Settings > Environment Variables

# Backend API URL — must point to your deployed backend
# Local:  http://localhost:5000/api
# Prod:   https://your-backend-host.onrender.com/api
VITE_API_URL=https://khidma-backend.onrender.com/api

# Frontend URL — used for CORS and redirect links
# Local:  http://localhost:5173
# Prod:   https://your-app.vercel.app
VITE_FRONTEND_URL=https://khidma.vercel.app
